@startuml c1-system-context
!include <C4/C4_Context>
title C1 · System context · EVE Distance Meter 0.7
LAYOUT_LEFT_RIGHT()

Person(user, "EVE player (you)", "Signs in with a main, enters or pastes the target system, reacts to structure alerts, picks which character to fly")
System(evedm, "EVE Distance Meter", "Ranks your characters by stargate jumps, draws routes on a 2D star map, lists wars, structures and structure alerts")
System_Ext(sso, "EVE SSO", "login.eveonline.com - OAuth 2.0 authorization code + refresh, JWT access tokens")
System_Ext(esi, "ESI", "esi.evetech.net - location, ship, online, assets, structures, wars, killmails, autopilot waypoint")
System_Ext(client, "EVE game client", "Receives the autopilot destination set through ESI (only on 'Set destination')")
System_Ext(zkb, "zKillboard R2Z2", "r2z2.zkillboard.com - live killmail feed, one file per kill")
System_Ext(everef, "EVE Ref", "data.everef.net - public structure dataset")
System_Ext(discord, "Discord", "Webhooks for new wars and structure alerts (optional); the existing bot's channel is read by the user")
System_Ext(sde, "CCP static data (SDE)", "developers.eveonline.com - solar systems, stargates, ship types")

Rel(user, evedm, "target system, characters, wars, alerts, Set destination", "HTTPS (browser / phone)")
Rel(user, discord, "reads notifications")
Rel(evedm, sso, "sign-in, add characters, refresh tokens", "HTTPS")
Rel(evedm, esi, "character state, structures, wars, killmails, waypoint", "HTTPS + Bearer JWT")
Rel(esi, client, "autopilot destination")
Rel(evedm, zkb, "follows the killmail sequence", "HTTPS, User-Agent, >= 6 s when caught up")
Rel(evedm, everef, "structure dataset, daily", "HTTPS")
Rel(evedm, discord, "war and alert posts", "HTTPS webhook")
Rel(evedm, sde, "universe build (offline, on update)", "HTTPS download")
SHOW_LEGEND()
@enduml
