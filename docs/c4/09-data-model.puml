@startuml data-model
title Database schema v20 (one file evedm.sqlite3, WAL, on the /app/data volume)
skinparam shadowing false
hide circle
hide methods
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #5B6B82
}
entity users {
  * user_id : INTEGER <<PK>> (the main's character ID)
  --
  name : TEXT
  corporation_id : INTEGER
  alliance_id : INTEGER (read from ESI; the alliance gate)
  affiliation_at : REAL
  created_at, last_login_at : REAL
}
entity characters {
  * owner_id : INTEGER <<PK, FK users>>
  * character_id : INTEGER <<PK>>
  --
  name : TEXT
  enabled : INTEGER
  notify : INTEGER (Notifications tick, default 1)
  tags : TEXT (JSON)
  status : OK | LIMITED | REAUTH
  scopes : TEXT (JSON)
  owner_hash : TEXT
  demo : INTEGER
  added_at : REAL
}
entity tokens {
  * owner_id : INTEGER <<PK, FK>>
  * character_id : INTEGER <<PK, FK>>
  --
  client_id : TEXT
  access_token : BLOB <<Fernet>>
  access_expires_at : REAL
  refresh_token : BLOB <<Fernet>>
  refresh_tail : TEXT
  updated_at : REAL
}
entity snapshots {
  * character_id : INTEGER <<PK, FK>>
  --
  solar_system_id, station_id, structure_id
  ship_type_id, ship_item_id, ship_name
  online, last_login, last_logout
  fetched_at : REAL
  error : TEXT
}
entity launches {
  * id : INTEGER <<PK>>
  --
  started_at, stopped_at, version, pid, mode
  python, platform, cpu_count
  rss_mb_start, rss_mb_peak, requests
  config : TEXT (JSON, no secrets)
}
entity sso_states {
  * state : TEXT <<PK>>
  --
  purpose : login | add
  created_at : REAL
  used : INTEGER
}
entity target_history {
  * solar_system_id : INTEGER <<PK>>
  --
  used_at : REAL
}
entity type_names {
  * type_id : INTEGER <<PK>>
  --
  name : TEXT
}
entity meta {
  * key : TEXT <<PK>>
  --
  value : TEXT
}
entity static_characters {
  * owner_id : INTEGER <<PK>>
  * name_key : TEXT <<PK>>
  --
  char_name : TEXT
  system_name_raw : TEXT
  system_id : INTEGER (NULL while unresolved)
  resolve_state : resolved | not_found | ambiguous
  suggestions : TEXT (JSON)
  tags : TEXT (JSON)
  note : TEXT
  enabled : INTEGER
  uploaded_at : REAL
}
entity character_notifications {
  * character_id : INTEGER <<PK>>
  * notification_id : INTEGER <<PK>>
  --
  type : TEXT
  sender_id : INTEGER
  sender_type : TEXT
  timestamp : TEXT (EVE time)
  body : TEXT (YAML from ESI)
  solar_system_id : INTEGER
  structure_id : INTEGER
  structure_type_id : INTEGER
  created_at : REAL
  posted : 0 pending | 1 posted | 2 not posted (Discord, v11)
}
entity notification_posts {
  * event_key : TEXT <<PK>> (type : structure or system : time)
  --
  message_id : TEXT (Discord message, edited for more recipients)
  characters : TEXT (JSON names)
  created_at : REAL
}
entity notification_zkb {
  * event_key : TEXT <<PK>> (as notification_posts, v19)
  --
  notification_type : TEXT
  solar_system_id : INTEGER
  structure_type_id : INTEGER
  event_at : REAL (the notification's time)
  received_at : REAL
  status : pending | found | not_found | skipped
  planned : INTEGER
  checks : INTEGER
  next_check_at : REAL
  deadline_at : REAL
  killmail_id : INTEGER
  killmail_time : TEXT
  zkb_url : TEXT
  source : feed | api
  error : TEXT (last zKillboard API problem)
  character_id : INTEGER
  notification_id : INTEGER
}
entity notification_characters {
  * character_id : INTEGER <<PK>>
  --
  checked_at : REAL
  next_check_at : REAL
  notifications : INTEGER
  error : TEXT
}
entity notification_reads {
  character_id : INTEGER
  read_at : REAL
  --
  status : 200 | 304 | 0 (no answer, v18)
  data_age_s : REAL (Date - Last-Modified)
  lifetime_s : REAL (Expires - Date)
  late_s : REAL (read time - scheduled time)
  new : INTEGER
  max_delay_s : REAL
  error : TEXT
}
entity ansiblex_gates {
  * structure_id : INTEGER <<PK>>
  --
  name, owner_id, solar_system_id
  dest_system_id : INTEGER (parsed from "A » B - name")
  status : ok | not_gate | no_access
  checked_at : REAL
}
entity ansiblex_access {
  * character_id : INTEGER <<PK>>
  * structure_id : INTEGER <<PK, FK>>
  --
  seen_at : REAL (the character's structure search found the gate)
}
entity ansiblex_characters {
  * character_id : INTEGER <<PK>>
  --
  checked_at : REAL
  gates : INTEGER
  error : TEXT
}
entity public_structure_history {
  * structure_id : INTEGER <<PK>>
  --
  name, owner_id, owner_name, system_id, type_id, type_name
  observed : TEXT
  source : EVE Ref | Local index | Adam4EVE (v13)
}
entity known_structures {
  * structure_id : INTEGER <<PK>>
  --
  name, owner_id, solar_system_id, type_id (ESI /universe/structures/{id})
  status : new | ok | no_access | gone
  pos_x, pos_y, pos_z : REAL
  first_seen, last_seen, checked_at : REAL
}
entity structure_sightings {
  * structure_id : INTEGER <<PK, FK>>
  * character_id : INTEGER <<PK>>
  --
  seen_at : REAL (a character has an asset there; picks the token)
}
entity structure_access {
  * structure_id : INTEGER <<PK, FK>>
  * character_id : INTEGER <<PK>>
  --
  seen_at : REAL (ESI character search: the character may dock there; picks the token first; shown as a count only)
  term : TEXT (the system-name prefix or full name that returned it; NULL before v17)
}
entity scout_dock_search {
  * character_id : INTEGER <<PK>>
  --
  checked_at : REAL (last run; 0 = due at the next scout run)
  found : INTEGER (IDs returned by the last run)
  capped : INTEGER (terms of this pass still at the cap after the split into full names)
  cursor : INTEGER (next term of the character's prefix list)
  passes : INTEGER (complete passes; 0 = the first one is still running)
  pass_started_at : REAL
  error : TEXT
}
entity structure_refusals {
  * structure_id : INTEGER <<PK>>
  * character_id : INTEGER <<PK>>
  --
  refused_at : REAL (ESI answered 403; not asked again for no_access_refresh_hours)
}
entity scout_characters {
  * character_id : INTEGER <<PK>>
  --
  checked_at : REAL
  structures : INTEGER
  error : TEXT
}
entity structure_mail_finds {
  * structure_id : INTEGER <<PK>> (one find per structure, no FK: the row may exist before known_structures has it)
  --
  owner_id : INTEGER (corporation link that followed the structure link; NULL = none)
  type_id : INTEGER
  name : TEXT (the link text)
  system_id : INTEGER (from the text before the first " - "; NULL = not recognised)
  mail_id : INTEGER (newest mail that named it)
  mail_ts : REAL (that mail's timestamp)
  found_at : REAL
}
entity mail_reads {
  * mail_id : INTEGER <<PK>> (global: a mail sent to several characters is parsed once; no text is kept)
  --
  read_at : REAL
  finds : INTEGER
}
entity scout_mail {
  * character_id : INTEGER <<PK>>
  --
  checked_at : REAL (0 = retry at the next run)
  last_mail_id : INTEGER (mails up to this ID were seen)
  mails : INTEGER (bodies opened by the last run)
  found : INTEGER (finds of the last run)
  error : TEXT
}
users ||--o{ characters
characters ||--|| tokens
known_structures ||--o{ structure_sightings
known_structures ||--o{ structure_refusals
known_structures ||--o{ structure_access
characters ||--o| scout_dock_search
characters ||--o| snapshots
characters ||--o{ character_notifications
characters ||--o| notification_characters
characters ||--o{ notification_reads
notification_posts ||--o| notification_zkb : same event_key
characters ||--o| scout_characters
characters ||--o| scout_mail
known_structures ||--o| structure_mail_finds : same structure_id
structure_mail_finds }o..o{ mail_reads : mail_id (finds of a parsed mail)
characters ||--o| ansiblex_characters
characters ||--o{ ansiblex_access
ansiblex_gates ||--o{ ansiblex_access
known_structures ||--o| public_structure_history
@enduml
