@startuml seq-thera-route
title UC-15 · Ranking through Thera / Turnur (EVE-Scout wormholes)
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber
actor "User" as user
participant "Browser UI\n(rank.js + map.js)" as ui
participant "Routes" as web
participant "EveScout" as evs
participant "RankingService" as rs
participant "GateGraph" as g
participant "EVE-Scout\napi.eve-scout.com" as ext

user -> ui : choose Gates only / Thera / Turnur (radio buttons, kept in the evedm_prefs cookie)
ui -> web : GET /api/rank?target=T&hub=turnur
web -> evs : ensure_fresh()
alt list older than refresh_s (900 s = 15 min)
  evs -> ext : GET /v2/public/signatures
  alt answered
    ext --> evs : signatures (hub, in_system, remaining_hours, type, max_ship_size, in_signature, out_signature)
    evs -> ext : GET ...?system_name=<hub> only for a configured hub missing from the answer
    evs -> evs : keep Thera / Turnur rows, drop J-space and unknown systems (End Of Life rows are kept),\none row per system, order by security (high first), then name
  else error / timeout
    evs -> evs : keep the last list, remember the error (shown under the filter)
  end
end
web -> rs : rank(target, evescout, hubs=[chosen hub])
rs -> g : bfs(target) : direct gate routes of the characters
loop the chosen hub (thera=1: every hub) with a list
  rs -> evs : via(character system, target)
  evs -> g : multi_bfs(listed systems, avoid) (cached per hub and list version)
  g --> evs : nearest listed system + gate path for the character and for the target
  evs -> evs : entry = closest listed system to the character (higher security wins a tie)\nexit = closest listed system to the target (same rule)\njumps = gates to entry + 2 (wormhole in and out) + gates from exit
  note right: entry = exit: the plain gate route is shorter, hub skipped
end
rs -> rs : fewest jumps over the chosen hubs; used only when STRICTLY shorter than the direct gate route
rs --> web : rows with jumps, route, route_legs [gate, wormhole, gate], wormhole{hub, entry, exit, direct_jumps, used,\nin / out signature and size of entry and exit, min_size}
web --> ui : JSON + evescout status
ui -> ui : "via Thera" badge, note in the route bar, dashed purple wormhole leg between two gold gate legs on the map;\nroute bar: InSig / OutSig beside entry and exit, ship-size icon (smaller of the two) in the hub hop
@enduml
