@startuml seq-members-tabs
title UC-13 / UC-14 · Notifications and Structures for members of the configured alliance (BB)
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber
actor "Member" as user
actor "Other player" as other
participant "Browser UI" as ui
participant "Routes" as web
participant "AllianceGate" as gate
participant "NotificationService" as ntf
participant "StructureScout" as scout
participant "CharacterService" as chars
participant "ESI" as esi
participant "Discord\n(wars webhook)" as discord
database "SQLite" as db

== sign-in: the alliance of the main is read ==
user -> ui : Sign in with EVE SSO
ui -> web : GET /sso/callback
web -> gate : refresh(main, force)
gate -> esi : GET /characters/{main} (public)
esi --> gate : corporation_id, alliance_id
gate -> db : users.alliance_id, affiliation_at
web --> ui : 303 /  (nav shows Notifications + Structures only when alliance_id is in access.alliance_ids)

== background: notifications of registered characters (loop sleeps until the earliest due character, 5 s .. poll_s) ==
ntf -> db : characters with the notifications scope and a valid token (status is not REAUTH),\nwhoever linked them, one link per character,\nwith characters.notify = 1 and >= min_structures (1) player structures holding assets
loop each character whose ESI cache (600 s) has expired
  ntf -> chars : access_token(character, owner)
  ntf -> esi : GET /characters/{id}/notifications (ETag)
  esi --> ntf : notifications (YAML text)
  ntf -> db : INSERT OR IGNORE character_notifications
  ntf -> db : next_check_at = ESI Expires + 1 s (30 .. 600 s), moved later by up to stagger_s\nto spread the reads over the window; transient error: retry after 60 s
  ntf -> web : new stored: version + 1, pages holding GET /api/notifications/wait are answered
  ntf -> discord : POST one embed per event, PATCH it when another character gets the same
end

== background: structures where any asset is stored (every interval_min) ==
loop each character with a valid token and the asset scope
  scout -> chars : access_token(character, owner)
  scout -> esi : GET /characters/{id}/assets (paged)
  esi --> scout : assets with location_id
  scout -> scout : keep locations >= 1e12 that are not the character's own items (structure IDs)
  scout -> db : structure_sightings, known_structures
end
loop each known structure (re-read every structure_refresh_hours)
  scout -> chars : token of a character that has assets there
  scout -> esi : GET /universe/structures/{id}
  esi --> scout : name, owner_id, solar_system_id, type_id, position (403: try the next character, 404: gone)
  scout -> db : UPDATE known_structures
end

== a member looks ==
user -> ui : open Notifications / Structures
ui -> web : GET /api/notifications  |  GET /api/structures
web -> gate : allowed(main)?  (refresh when older than 6 h)
alt alliance of the main is in access.alliance_ids
  web -> db : notifications of all valid characters / all known structures
  web -> web : one BFS per notification system or nearest-origin BFS from the caller's characters
  web --> ui : cards with region, Thera / Turnur label (the closer hub), three closest characters with route type / structure rows with jumps
else any other alliance (or alliance not known yet)
  web --> ui : 404, and no link in the navigation
end
other -> ui : open /notifications or /structures
ui -> web : GET
web --> ui : 404
@enduml
