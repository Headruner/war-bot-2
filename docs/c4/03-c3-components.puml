@startuml c3-components
!include <C4/C4_Component>
title C3 · Components of the web app (package evedm)
LAYOUT_TOP_DOWN()

Container(spa, "Browser UI", "JS", "rank.js, map.js, characters.js, roster.js, wars.js, alerts.js, prefs.js; members only: notifications.js, structures.js")
ContainerDb(db, "SQLite", "evedm.sqlite3")
System_Ext(sso, "EVE SSO")
System_Ext(esi, "ESI")
System_Ext(zkb, "zKillboard R2Z2")
System_Ext(evescout, "EVE-Scout")
System_Ext(discord, "Discord webhook")

Container_Boundary(web, "Web app") {
  Component(routes, "Routes", "web/app.py", "Pages, /api/*, /sso/*, session sign-in, CSRF header check")
  Component(resolver, "TargetResolver", "resolver.py", "Autocomplete, Dotlan / in-game links and plain names in pasted text")
  Component(ranking, "RankingService", "ranking.py", "Single-flight refresh, stale-while-revalidate, sort, routes, flags")
  Component(graph, "GateGraph", "universe.py", "CSR adjacency, BFS with parent pointers, avoid list, map payload")
  Component(provider, "Live / Demo provider", "ranking.py", "Character state from ESI or from seeded snapshots")
  Component(chars, "CharacterService", "characters.py", "Store tokens, refresh when < 60 s left, REAUTH on invalid_grant")
  Component(bundle, "BundleIO", "bundle.py", "JSON bundle v1: schema, per-entry refresh, report, export")
  Component(roster, "RosterService", "roster.py", "Static roster v1: schema, merge by name, system resolution, ranking without ESI, export")
  Component(gate, "AllianceGate", "access.py", "Reads the alliance of the signed-in main from ESI (at sign-in, then every 6 h), caches it, decides who sees Notifications and Structures")
  Component(ntf, "NotificationService", "notifications.py", "Polls the notifications of every registered character with a valid token (ESI cache aware), parses, filters")
  Component(auth, "AuthService", "sso.py", "Authorize URL, code exchange, refresh, revoke, JWT validation via JWKS")
  Component(esiclient, "EsiClient", "esi.py", "Expires/ETag cache, request coalescing, 429/420 handling, concurrency limit")
  Component(cipher, "TokenCipher", "crypto.py", "Fernet encryption at rest, log redaction")
  Component(store, "Database", "db.py", "Schema v8, migration chain, batched snapshot writes")
  Component(launch, "Logs + LaunchRecorder", "logs.py", "Rotating log, launches table + launches.jsonl, RSS")
  Component(wars, "WarService", "wars/", "New wars, census, statistics, StructureIndex (EVE Ref + scout finds)")
  Component(scout, "StructureScout", "scout.py", "Assets of every registered character (ESI) -> every structure holding one -> /universe/structures/{id} (ESI): name, owner, type, system, position")
  Component(alerts, "AlertService + R2Z2Feed", "alerts.py", "Follows the killmail feed, classifies destroyed / combat / firing, stores, posts to Discord")
  Component(evs, "EveScout", "evescout.py", "Thera / Turnur signature list (15-minute cache, last list kept on error, hub missing from the answer fetched by name), closest listed system to the character and to the target through a cached multi-source BFS, two-leg gate-wormhole-gate plan")
}

Rel(spa, routes, "HTTPS")
Rel(routes, resolver, "search / resolve")
Rel(routes, ranking, "rank(target)")
Rel(routes, bundle, "import / export")
Rel(routes, auth, "SSO flows")
Rel(ranking, graph, "bfs + route")
Rel(ranking, provider, "fetch states")
Rel(provider, chars, "access token")
Rel(provider, esiclient, "location / ship / online")
Rel(chars, auth, "refresh")
Rel(chars, cipher, "encrypt / decrypt")
Rel(bundle, chars, "store")
Rel(bundle, auth, "verify + refresh")
Rel(chars, store, "tokens")
Rel(ranking, store, "snapshots")
Rel(store, db, "sqlite3")
Rel(auth, sso, "HTTPS")
Rel(esiclient, esi, "HTTPS")
Rel(routes, launch, "start / stop")
Rel(routes, alerts, "alerts by structure")
Rel(routes, evs, "ensure_fresh, status, list")
Rel(ranking, evs, "via(origin, target): wormhole plan, used only when shorter")
Rel(evs, graph, "multi_bfs(listed systems), walk")
Rel(evs, evescout, "GET /v2/public/signatures", "HTTPS")
Rel(routes, gate, "members only? (Notifications, Structures)")
Rel(routes, ntf, "all notifications of the site")
Rel(routes, scout, "structure list")
Rel(gate, esiclient, "GET /characters/{id} (public)")
Rel(gate, store, "users.alliance_id, affiliation_at")
Rel(ntf, chars, "token of each valid character")
Rel(ntf, esiclient, "/characters/{id}/notifications, moons")
Rel(ntf, store, "character_notifications, notification_characters")
Rel(scout, chars, "token of each character with assets scope")
Rel(scout, store, "known_structures, structure_sightings")
Rel(routes, esiclient, "Set destination (POST /ui/autopilot/waypoint)")
Rel(alerts, zkb, "sequence.json, {n}.json", "HTTPS")
Rel(alerts, esiclient, "types, groups, killmails, names")
Rel(alerts, scout, "known structures")
Rel(alerts, wars, "StructureIndex")
Rel(alerts, discord, "embeds", "HTTPS")
Rel(scout, esiclient, "assets, structures")
Rel(alerts, store, "structure_alerts")
SHOW_LEGEND()
@enduml
