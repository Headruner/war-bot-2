# Copy to .env and fill in. Never commit .env.
EVEDM_SECRET_KEY=change-me-to-a-long-random-string
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8080/sso/callback
EVEDM_ALLOWED_LOGIN_CHARACTERS=
# 1 = demo mode (fictional characters, no EVE application needed)
EVEDM_DEMO=0
EVEDM_SQLITE_JOURNAL=wal
# War watcher (config/wars.yaml). Set EVEDM_WARS_ENABLED=0 to switch it off.
EVEDM_WARS_ENABLED=1
EVEDM_WARS_CONTACT=
# Post new wars to Discord as well (webhook URL is a secret)
EVEDM_WARS_DISCORD_ENABLED=0
EVEDM_WARS_DISCORD_WEBHOOK=
EVEDM_WARS_DISCORD_MENTION_ROLE_ID=
