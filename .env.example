# Copy to .env and fill in. Never commit .env.
EVEDM_SECRET_KEY=change-me-to-a-long-random-string
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8080/sso/callback
EVEDM_ALLOWED_LOGIN_CHARACTERS=
# 1 = demo mode (fictional characters, no EVE application needed)
EVEDM_DEMO=0
EVEDM_SQLITE_JOURNAL=wal
# Optional scopes: tick esi-universe.read_structures.v1 and esi-assets.read_assets.v1 (structure scout) and
# esi-ui.write_waypoint.v1 ("Set destination") on your EVE application first.
# EVE_OPTIONAL_SCOPES=none asks only for the ranking scopes (no scout, no Set destination).
EVEDM_STRUCTURES_ENABLED=1
EVE_OPTIONAL_SCOPES=
# War watcher (config/wars.yaml). Set EVEDM_WARS_ENABLED=0 to switch it off.
EVEDM_WARS_ENABLED=1
EVEDM_WARS_CONTACT=
# Address of this site, used in Discord links (default: taken from EVE_CALLBACK_URL)
EVEDM_PUBLIC_URL=
# Post new wars to Discord as well (webhook URL is a secret)
EVEDM_WARS_DISCORD_ENABLED=0
EVEDM_WARS_DISCORD_WEBHOOK=
EVEDM_WARS_DISCORD_MENTION_ROLE_ID=
# Structure alerts (Alerts page) from zKillboard's live killmail feed. Set EVEDM_ALERTS_ENABLED=0 to switch off.
EVEDM_ALERTS_ENABLED=1
EVEDM_ALERTS_CONTACT=
# Post structure alerts to Discord as well (may be another channel than the wars one; the URL is a secret)
EVEDM_ALERTS_DISCORD_ENABLED=0
EVEDM_ALERTS_DISCORD_WEBHOOK=
EVEDM_ALERTS_DISCORD_MENTION_ROLE_ID=
