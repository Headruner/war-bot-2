# Keep the build context small and secrets out of the image
.git
.github
.idea
.vscode
.env
*.log
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data and secrets are mounted by docker-compose.yml
data/
config/credentials.json

# Not needed at runtime
tests/
test_data/
docs/
skills/
publish-nexus.sh
